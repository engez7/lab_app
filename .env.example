# Flask Configuration
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here-change-this

# Database
DB_PATH=/var/www/lab_app/lab_app.db

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_RELAY=esp/relay/thermo_z01
MQTT_TOPIC_TEMPHUM=esp/dht/TempHum_z01

# Data Management
DATA_RETENTION_DAYS=90

# MQTT Logging
MQTT_SLEEP_INTERVAL=600

# HTTP Basic Auth for the relay control routes (/T1_on/, /T1_off/)
# Required: without both set, those routes deny every request.
AUTH_USERNAME=your-username
AUTH_PASSWORD=your-strong-password
